# GenChat Environment Configuration Template
# Copy this file to .env and configure strong secrets before launching in production.
# IMPORTANT: Never commit .env into source control!

# ==============================================================================
# 1. Domain, Public URLs & Reverse Proxy
# ==============================================================================
GENCHAT_DOMAIN=genchat.app
ACME_EMAIL=admin@genchat.app

# ==============================================================================
# 2. Authentication & Cryptographic Secrets
# ==============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# ==============================================================================
# 3. PostgreSQL Database
# ==============================================================================
POSTGRES_DB=genchat
POSTGRES_USER=genchat
POSTGRES_PASSWORD=dev_password

# ==============================================================================
# 4. Redis Cache & Presence Directory
# ==============================================================================
REDIS_PASSWORD=

# ==============================================================================
# 5. Object Storage (MinIO / S3 Encrypted Media Blobs)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=minio:9000

# ==============================================================================
# 6. WebRTC TURN / STUN Media Calling
# ==============================================================================
TURN_SHARED_SECRET=dev_turn_shared_secret_32b_change_in_prod
TURN_REALM=genchat.local
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp

# ==============================================================================
# 7. WebAuthn Relying Party & Origin Guards
# ==============================================================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5134
ALLOWED_ORIGINS=http://localhost:5134,http://localhost:3000,http://localhost:5173

# ==============================================================================
# 8. Edge Gateway Limits & Policy
# ==============================================================================
WS_ALLOW_ANY_ORIGIN=true
DEVICE_CAP_POLICY=evict_oldest
MAX_HEAP_MB=1536
GOMEMLIMIT=1800MiB
