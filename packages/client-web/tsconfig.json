{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@genchat/client-crypto": ["../client-crypto/src/index.ts"],
      "@genchat/client-crypto/*": ["../client-crypto/src/*"],
      "@genchat/client-db": ["../client-db/src/index.ts"],
      "@genchat/client-db/*": ["../client-db/src/*"]
    }
  },
  "include": ["src"]
}
